{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rulith Brain Agent",
  "version": "0.2.0",
  "identifier": "ai.rulith.brain.agent",
  "mainBinaryName": "rulith-brain-agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rulith",
    "copyright": "Copyright (c) 2026 Victor Shaw",
    "category": "Productivity",
    "shortDescription": "Rulith Brain Agent",
    "longDescription": "The companion agent of Rulith Brain, in a window of its own",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/agent-hooks.nsh",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
